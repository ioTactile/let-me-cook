{
  "name": "let-me-cook-backend",
  "version": "1.0.0",
  "description": "Backend pour l'application de cuisine intelligente",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "deploy": "docker-compose -f docker-compose.prod.yml up -d",
    "deploy:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "deploy:down": "docker-compose -f docker-compose.prod.yml down"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^7.23.0",
    "pg": "^8.14.1",
    "pgvector": "^0.3.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.0.0",
    "module-alias": "^2.2.3",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "_moduleAliases": {
    "@": "./dist"
  }
}
